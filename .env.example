# ── Required: Supabase ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Site URLs (use http://localhost:5173 for local development) ──────────────
VITE_SITE_URL=http://localhost:5173
VITE_APP_URL=http://localhost:5173

# ── Supabase Edge Function secrets (set via `supabase secrets set`) ──────────
# Required for all authenticated edge functions:
#   SUPABASE_URL         (automatically available inside Supabase Edge Functions)
#   SUPABASE_ANON_KEY    (automatically available inside Supabase Edge Functions)
#   SUPABASE_SERVICE_ROLE_KEY  (automatically available inside Supabase Edge Functions)

# ── Playwright Runner ───────────────────────────────────────────────────────
# See playwright-runner/.env.example for runner-specific configuration
