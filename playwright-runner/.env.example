# Port the Express server listens on
PORT=3456

# Secret token to authenticate requests from the Supabase edge function
# Must match the PLAYWRIGHT_RUNNER_SECRET secret set in Supabase
PLAYWRIGHT_RUNNER_SECRET=your-secret-token-here

# Supabase project URL (for direct DB/storage access)
SUPABASE_URL=https://your-project.supabase.co

# Optional comma-separated list of extra http(s) origins the runner may navigate to
# (e.g. your production app). SUPABASE_URL's origin is always allowed.
# PLAYWRIGHT_ALLOWED_BASE_ORIGINS=https://app.example.com

# Root directory for upload_file steps; paths must resolve under this folder
# PLAYWRIGHT_UPLOAD_ROOT=/var/lib/doc-studio-uploads

# Storage bucket for screenshots and assets
STORAGE_BUCKET=doc-studio-assets

# Demo account credentials
# The username is shared across all demo accounts
DEMO_ACCOUNT_USERNAME=demo@yourapp.com

# Per-account password env keys — add one per demo account configured in the DB
# The key name must match the env_password_key field on the documentation_demo_accounts row
DEMO_ACCOUNT_PASSWORD=your-demo-password-here
# STAGING_ACCOUNT_PASSWORD=your-staging-password-here
